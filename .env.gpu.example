# ===========================================================================================
# PERFIL GPU (recomendado): requiere una GPU NVIDIA con 8 GB de VRAM o más y Docker con acceso
# a la GPU (Docker Desktop con WSL2, o NVIDIA Container Toolkit en Linux).
# Usa llama3 (8B) y ejecuta Ollama y el reranker en la GPU.
#
#   Uso:  cp .env.gpu.example .env      (y luego:  docker compose up -d)
#
#   ¿No tienes GPU NVIDIA? Usa el perfil CPU:  cp .env.example .env
#
# No contiene secretos reales.
# ===========================================================================================

# --- Activación de la GPU en Docker Compose (no borrar) ---
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.gpu.yml
# Imagen de la aplicación con PyTorch para CUDA
TORCH_INDEX=https://download.pytorch.org/whl/cu126

# --- Puerto de la aplicación en tu máquina ---
APP_PORT=8080

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
DATA_DIR=data

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama3
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_KEEP_ALIVE=10m
LLM_MAX_ANSWER_TOKENS=700
# Reescribe las preguntas de seguimiento usando el historial antes de buscar
QUERY_REWRITING_ENABLED=true

# --- Embeddings y reranker ---
EMBEDDING_MODEL=bge-m3
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# El reranker usa la GPU (en media precisión)
RERANKER_DEVICE=cuda
RERANKER_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120

# --- Recuperación ---
HYBRID_SEARCH_ENABLED=true
RETRIEVAL_TOP_K=20
# Candidatos que puntúa el reranker (con GPU, 20 cuestan ~0,3 s)
RERANK_CANDIDATES=20
RERANK_TOP_N=5
RRF_K=60
# Por debajo de este puntaje el sistema responde que no tiene información
MIN_RELEVANCE_SCORE=0.15
# Umbral equivalente sin reranker (similitud coseno de la búsqueda vectorial)
MIN_VECTOR_SIMILARITY=0.45

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- ChromaDB ---
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=bancos
CHROMA_TIMEOUT_SECONDS=30

# --- PostgreSQL (historial de conversaciones) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=5
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# --- Historial conversacional ---
# N: cantidad de mensajes previos que se usan como contexto
HISTORY_MAX_MESSAGES=6
MAX_QUESTION_LENGTH=1000
RATE_LIMIT_PER_MINUTE=30
# Respuestas que se generan a la vez (la GPU atiende pocas en paralelo)
MAX_CONCURRENT_CHATS=4
MAX_REQUEST_BYTES=65536
# Solo detrás de un proxy de confianza (usa X-Forwarded-For para identificar al cliente)
TRUST_PROXY_HEADERS=false

# --- Analítica ---
# Minutos que tomaría buscar manualmente una respuesta (para estimar el tiempo ahorrado)
ANALYTICS_MANUAL_SEARCH_MINUTES=4
# Si se define, el endpoint y el dashboard de analítica exigen este token
ANALYTICS_TOKEN=

# --- Scraping ---
# Bancos soportados: bbva, bancolombia, davivienda
SCRAPE_BANKS=bbva,bancolombia,davivienda
SCRAPE_MAX_PAGES_PER_BANK=250
SCRAPE_MAX_DEPTH=5
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_TIMEOUT_SECONDS=20
SCRAPE_MAX_RETRIES=3
SCRAPE_USER_AGENT=rag-bancos-colombia/0.1 (proyecto academico)
